# Application
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# Use stub implementations (in-memory) instead of real services
# When true: Uses in-memory stores, mock agent, no database connections
# When false: Connects to Redis, PostgreSQL, Neo4j, Qdrant, uses real Claude
# Default: true (safe for development without infrastructure)
USE_STUBS=false

# Hot-reload .env on each request (development only)
# When true: Re-reads .env file on each request, allowing changes without restart
# When false: Uses values set at startup (production behavior)
# Default: false
HOT_CONFIG=false

# AI Providers
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# =============================================================================
# FEATURE SELECTION
# =============================================================================
# Master switches for all major system features.
# Set to false to completely disable a feature regardless of other config.
# Features are enabled by default when their dependencies are available.
#
# -----------------------------------------------------------------------------
# CORE-ONLY MODE (Minimal Configuration)
# -----------------------------------------------------------------------------
# For pure prompt + history -> LLM -> response without extra features:
#
#   USE_STUBS=false                    # Use real database (required for prompts)
#   ENABLE_CRISIS_DETECTION=false      # No crisis detection
#   ENABLE_DEEP_CRISIS_EVAL=false      # No deep crisis eval
#   ENABLE_SAFETY_VALIDATION=false     # No safety checks
#   ENABLE_RESPONSE_EVALUATION=false   # No quality scoring (uses silent NoOpEvaluator)
#   ENABLE_ENTITY_EXTRACTION=false     # No entity extraction
#   COMPACTION_ENABLED=false           # No context compaction
#   MEMORY_REFLECTOR_ENABLED=false     # No insight extraction
#   MEMORY_PROMPT_ENABLED=false        # No phase-shifted memory
#   EMBEDDING_BATCH_ENABLED=false      # No background embeddings
#   ENABLE_POSTFLIGHT_EMBEDDINGS=false # No message embeddings (saves OpenAI API $)
#   ENABLE_L3_QUERIES=false            # No Neo4j entity queries during retrieval
#   MEMORY_TOOL_ACCESS=off             # No memory tools for agent
#   ENABLE_TOOLS=false                 # No agent tools (logMood)
#   ENABLE_TRACING=false               # No OpenTelemetry tracing
#
# This gives you: System prompt (disk/db) + conversation history -> Claude -> response
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Pipeline Processing Features
# -----------------------------------------------------------------------------

# Safety validation - PII detection, medical advice filtering, enabling language
# When false, safety checks are skipped (not recommended for production)
ENABLE_SAFETY_VALIDATION=true

# Response evaluation - LLM-based quality scoring of agent responses
# When false, no quality evaluation occurs. See EVALUATION_MODE for fine-tuning.
ENABLE_RESPONSE_EVALUATION=true

# Agent tools - Allow Claude to use tools (logMood, etc.)
# When false, agent tools are not provided to Claude
ENABLE_TOOLS=true

# -----------------------------------------------------------------------------
# Crisis Detection Features
# -----------------------------------------------------------------------------

# Fast crisis detection - Keyword-based pattern matching (<10ms)
# When false, crisis detector always returns safe (level 1)
ENABLE_CRISIS_DETECTION=true

# Deep crisis evaluation - LLM-based secondary analysis (parallel with agent)
# When false, only fast detection runs. Requires ANTHROPIC_API_KEY.
ENABLE_DEEP_CRISIS_EVAL=true

# -----------------------------------------------------------------------------
# Memory System Features
# -----------------------------------------------------------------------------

# Memory prompts - Phase-shifted memory architecture (RECOMMENDED)
# Moves heavy memory work to postflight, preflight drops to ~10-20ms
# When true, supersedes MEMORY_CONTEXT_MODE (legacy preflight memory)
MEMORY_PROMPT_ENABLED=true

# Entity extraction - Extract people, places, events from conversations
# When false, no entities are stored in Neo4j. See ENTITY_EXTRACTION_MODE for modes.
ENABLE_ENTITY_EXTRACTION=true

# L3 extraction mode - Use rich Cadillac schema with observations
# When false, uses legacy entity storage format
USE_L3_EXTRACTION=true

# Deep Memory - Enrich entities with original conversation context
# When false, entities have no sourceHistory context
DEEP_MEMORY_ENABLED=true

# Context compaction - Summarize old messages to reduce context size
# When false, full message history is always used
COMPACTION_ENABLED=true

# Memory reflector - Automatic insight extraction after each exchange
# When false, no automatic observations are created
MEMORY_REFLECTOR_ENABLED=true

# Embedding batch job - Background generation of L3/L4 embeddings
# When false, no background embedding processing occurs
EMBEDDING_BATCH_ENABLED=true

# Preflight embeddings - Query embeddings for semantic search during retrieval
# When false, skips query embedding and L4 semantic search
# Note: Only used when MEMORY_PROMPT_ENABLED=false (legacy mode)
ENABLE_PREFLIGHT_EMBEDDINGS=true

# Postflight embeddings - Message embeddings for L4 storage after response
# When false, skips embedding user/assistant messages (saves OpenAI API costs)
ENABLE_POSTFLIGHT_EMBEDDINGS=true

# L3 Neo4j queries - Entity lookups during memory retrieval
# When false, skips Neo4j entity queries during context assembly
ENABLE_L3_QUERIES=true

# -----------------------------------------------------------------------------
# Tool Features (see ENABLE_TOOLS above)
# -----------------------------------------------------------------------------

# Memory tools access level - Controls which memory tools are available to agent
# Options: off, read, write, full (see CLAUDE.md for details)
MEMORY_TOOL_ACCESS=off

# -----------------------------------------------------------------------------
# Observability Features
# -----------------------------------------------------------------------------

# OpenTelemetry tracing - Distributed tracing for request flow
# When false, no traces are exported. Requires OTEL_EXPORTER_OTLP_ENDPOINT.
ENABLE_TRACING=true

# =============================================================================

# L1: Redis
# URL can include auth: redis://:password@localhost:6379 or redis://user:password@localhost:6379
REDIS_URL=redis://localhost:6379
# Alternative: separate auth vars (used if URL doesn't include credentials)
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false

# User/Profile Cache TTL in minutes (cached in Redis, requires REDIS_URL)
# Reduces database hits from 2 per request to 0 on cache hits
USER_CACHE_TTL_MINUTES=60

# L2: PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverysky

# L3: Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
# Optional: default database name (default: neo4j)
NEO4J_DATABASE=neo4j
# Database-per-user mode: each user gets their own database (requires Dozer or Neo4j Enterprise)
# When true, userId is used as database name. Dozer auto-creates databases on first use.
NEO4J_DATABASE_PER_USER=false

# L4: Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=              # Optional, for Qdrant Cloud
# QDRANT_COLLECTION_NAME=messages  # Collection name (default: messages)
# QDRANT_SEARCH_MODE=hybrid    # Search mode: 'hybrid' (dense + sparse BM25, default) or 'simple' (dense only)

# Literature Search
# Semantic search for recovery literature via Qdrant 'literature' collection
# Requires QDRANT_URL and OPENAI_API_KEY to be set
LITERATURE_SEARCH_LIMIT=10

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=recoverysky-agent

# Crisis Response
CRISIS_THRESHOLD_HIGH=7
CRISIS_THRESHOLD_CRITICAL=9

# Crisis Alerting Webhook (Optional)
# When set, WebhookCrisisHandler sends POST requests on crisis detection
CRISIS_WEBHOOK_URL=
# Optional: HMAC-SHA256 secret for webhook signature (X-Crisis-Signature header)
CRISIS_WEBHOOK_SECRET=

# Evaluation Configuration
# Options: all (every response), sample:N (N% of responses), on_demand (default - when crisis/low score)
EVALUATION_MODE=on_demand

# Authentication (Zitadel)
# When ZITADEL_ISSUER is set, JWT authentication is required for /api/* endpoints
# Health endpoints remain public
ZITADEL_ISSUER=https://auth.rso
ZITADEL_AUDIENCE=your-client-id@your-project
# Alternative: can also use ZITADEL_CLIENT_ID instead of ZITADEL_AUDIENCE

# Meeting Discovery API
# RecoverySky Meeting API for findMeetings tool
MEETING_API_URL=http://localhost:4000
# Optional: Bearer token for authentication (if API requires auth)
MEETING_API_TOKEN=

# =============================================================================
# Active Memory System (Neo4j Knowledge Graph)
# =============================================================================

# Memory Tools for Claude
# Allows Claude to query/update the knowledge graph during conversation
# Access levels:
#   off   = no memory tools
#   read  = recallMemory, searchEntities, getRelatedEntities
#   write = read + saveNote, logObservation
#   full  = write + updateEntity, deleteEntity, createRelationship
MEMORY_TOOL_ACCESS=read

# Post-Agent Entity Extraction
# Extracts entities and relationships from conversations and stores them in Neo4j
# Mode options: all (default - every message), none (disabled), sample:N (N% of messages), significant (crisis >=4 only)
ENTITY_EXTRACTION_MODE=all
# Model to use for extraction (default: claude-haiku-4-5)
ENTITY_EXTRACTION_MODEL=claude-haiku-4-5
# Comma-separated list of entity types to extract
ENTITY_EXTRACTION_TYPES=person,place,event,emotion,trigger,coping_strategy,milestone,medication
# Minimum importance score (0.0-1.0) to store an entity
ENTITY_MIN_IMPORTANCE=0.3
# Whether to infer relationships between entities (with rich context properties)
ENTITY_INFER_RELATIONSHIPS=true

# =============================================================================
# Memory Prompts (Phase-Shifted Architecture)
# =============================================================================
# Moves heavy memory work from preflight to postflight.
# After each exchange, generates memory prompts stored in Redis L1 with per-key TTL.
# These are available on the NEXT request (1-exchange latency to "remember").
#
# Benefits:
# - Preflight drops from ~500-1000ms to ~10-20ms
# - Better query quality (Haiku sees full exchange, not just user input)
# - Natural topic decay via Redis TTL
#
# Requires REDIS_URL and ANTHROPIC_API_KEY to be set.
# Feature flag: MEMORY_PROMPT_ENABLED (see Feature Selection)

# Number of recent messages to analyze for memory retrieval (1=current exchange only)
MEMORY_PROMPT_RECENT_MESSAGES=1

# Maximum TTL in minutes for stored memory prompts
# Haiku scores each prompt 0-60 based on topic relevance:
#   0 = Don't store (ephemeral greetings, tangents)
#   5-15 = Quick topics (simple questions)
#   20-40 = Substantive discussions
#   45-60 = Deep emotional/recovery topics
MEMORY_PROMPT_MAX_TTL_MINUTES=60

# =============================================================================
# Deep Memory (Entity Context Enrichment)
# =============================================================================
# Enriches entities with original conversation context from extraction points.
# Feature flag: DEEP_MEMORY_ENABLED (see Feature Selection)

# Strategy for selecting source history entries: latest, created_and_latest, all
DEEP_MEMORY_STRATEGY=latest
# Number of messages to fetch around each source extraction point
DEEP_MEMORY_WINDOW=5

# =============================================================================
# L3 Embedding Batch Job
# =============================================================================
# Background job that generates embeddings for entities and observations.
# Creates dual embeddings: L3 (384-dim MiniLM local) and L4 (1536-dim OpenAI).
# Feature flag: EMBEDDING_BATCH_ENABLED (see Feature Selection)

# Interval between batch processing runs in milliseconds (default: 30000 = 30s)
EMBEDDING_BATCH_INTERVAL_MS=30000
# Maximum items to process per batch
EMBEDDING_BATCH_SIZE=100

# =============================================================================
# Context Compaction System
# =============================================================================
# Summarizes older messages to reduce context size while preserving information.
# Runs fire-and-forget after memory retrieval, parallel with agent processing.
# Requires REDIS_URL and ANTHROPIC_API_KEY to be set.
# Feature flag: COMPACTION_ENABLED (see Feature Selection)

# Message count threshold to trigger compaction
# Compaction runs when session has more than this many messages
COMPACTION_THRESHOLD=30

# Number of oldest messages to compact per batch
# These messages are summarized and replaced with a single summary message
COMPACTION_BATCH_SIZE=15

# LLM model for summarization (default: claude-haiku-4-5)
COMPACTION_MODEL=claude-haiku-4-5

# Maximum tokens for summary response
COMPACTION_MAX_TOKENS=512

# Timeout for LLM summarization call in milliseconds
COMPACTION_TIMEOUT_MS=15000

# =============================================================================
# Memory Reflector (Automatic Insight Extraction)
# =============================================================================
# Analyzes each exchange and automatically creates:
# - User insights (stored as observations on "self" entity)
# - Entity observations (attached to mentioned entities)
# - Reinforcements (boosts confidence on confirmed observations)
# Runs fire-and-forget after each exchange, parallel with other post-processing.
# Requires NEO4J_URI and ANTHROPIC_API_KEY to be set.
# Feature flag: MEMORY_REFLECTOR_ENABLED (see Feature Selection)

# Maximum recent insights to include in Haiku context (default: 10)
MEMORY_REFLECTOR_INSIGHT_LIMIT=10

# Maximum entities to include in Haiku context (default: 5)
MEMORY_REFLECTOR_ENTITY_LIMIT=5

# Minimum confidence to persist insight/observation (0.0-1.0, default: 0.5)
MEMORY_REFLECTOR_MIN_CONFIDENCE=0.5
