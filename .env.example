# Application
NODE_ENV=development
PORT=3333
LOG_LEVEL=debug
USE_STUBS=true

# AI Providers
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx

# L1: Redis
# URL can include auth: redis://:password@localhost:6379 or redis://user:password@localhost:6379
REDIS_URL=redis://localhost:6379
# Alternative: separate auth vars (used if URL doesn't include credentials)
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_DB=0
REDIS_TLS=false

# L2: PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverysky

# L3: Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
# Optional: default database name (default: neo4j)
NEO4J_DATABASE=neo4j
# Database-per-user mode: each user gets their own database (requires Dozer or Neo4j Enterprise)
# When true, userId is used as database name. Dozer auto-creates databases on first use.
NEO4J_DATABASE_PER_USER=false

# L4: Qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=              # Optional, for Qdrant Cloud

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=recoverysky-agent

# Crisis Response
CRISIS_THRESHOLD_HIGH=7
CRISIS_THRESHOLD_CRITICAL=9

# Crisis Alerting Webhook (Optional)
# When set, WebhookCrisisHandler sends POST requests on crisis detection
CRISIS_WEBHOOK_URL=
# Optional: HMAC-SHA256 secret for webhook signature (X-Crisis-Signature header)
CRISIS_WEBHOOK_SECRET=

# Evaluation Configuration
# Options: all (every response), sample:N (N% of responses), on_demand (default - when crisis/low score)
EVALUATION_MODE=on_demand

# Authentication (Zitadel)
# When ZITADEL_ISSUER is set, JWT authentication is required for /api/* endpoints
# Health endpoints remain public
ZITADEL_ISSUER=https://auth.rso
ZITADEL_AUDIENCE=your-client-id@your-project
# Alternative: can also use ZITADEL_CLIENT_ID instead of ZITADEL_AUDIENCE

# Meeting Discovery API
# RecoverySky Meeting API for findMeetings tool
MEETING_API_URL=http://localhost:4000
# Optional: Bearer token for authentication (if API requires auth)
MEETING_API_TOKEN=

# =============================================================================
# Active Memory System (Neo4j Knowledge Graph)
# =============================================================================

# Pre-Agent Memory Contextualization
# Retrieves relevant memories before agent processing and injects into prompt
# Mode options:
#   0 = off (no memory context)
#   1 = template (format with templates - free)
#   2 = haiku (use Claude Haiku to narrativize - ~$0.0003/msg)
#   3 = hybrid (templates for simple, Haiku for complex subgraphs)
MEMORY_CONTEXT_MODE=1

# Memory Tools for Claude
# Allows Claude to query/update the knowledge graph during conversation
# Access levels:
#   off   = no memory tools
#   read  = recallMemory, searchEntities, getRelatedEntities
#   write = read + saveNote, logObservation
#   full  = write + updateEntity, deleteEntity, createRelationship
MEMORY_TOOL_ACCESS=read

# Post-Agent Entity Extraction
# Extracts entities and relationships from conversations and stores them in Neo4j
# Mode options: all (default - every message), none (disabled), sample:N (N% of messages), significant (crisis >=4 only)
ENTITY_EXTRACTION_MODE=all
# Model to use for extraction (default: claude-3-haiku-20240307)
ENTITY_EXTRACTION_MODEL=claude-3-haiku-20240307
# Comma-separated list of entity types to extract
ENTITY_EXTRACTION_TYPES=person,place,event,emotion,trigger,coping_strategy,milestone,medication
# Minimum importance score (0.0-1.0) to store an entity
ENTITY_MIN_IMPORTANCE=0.3
# Whether to infer relationships between entities (with rich context properties)
ENTITY_INFER_RELATIONSHIPS=true
