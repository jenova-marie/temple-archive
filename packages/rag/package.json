{
  "name": "@siri/rag",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stubs": {
      "types": "./dist/stubs/index.d.ts",
      "import": "./dist/stubs/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@qdrant/js-client-rest": "^1.16.2",
    "@siri/db": "workspace:*",
    "@siri/observability": "workspace:*",
    "@siri/types": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
