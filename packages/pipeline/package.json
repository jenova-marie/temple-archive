{
  "name": "@siri/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@siri/agent": "workspace:*",
    "@siri/crisis": "workspace:*",
    "@siri/evaluation": "workspace:*",
    "@siri/memory": "workspace:*",
    "@siri/observability": "workspace:*",
    "@siri/safety": "workspace:*",
    "@siri/shared": "workspace:^",
    "@siri/tools": "workspace:*",
    "@siri/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
