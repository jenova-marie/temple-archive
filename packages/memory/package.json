{
  "name": "@recoverysky/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stubs": {
      "types": "./dist/stubs/index.d.ts",
      "import": "./dist/stubs/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@qdrant/js-client-rest": "^1.16.2",
    "@recoverysky/observability": "workspace:*",
    "@recoverysky/types": "workspace:*",
    "@xenova/transformers": "^2.17.2",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.8.2",
    "nanoid": "^5.1.6",
    "neo4j-driver": "^6.0.1",
    "openai": "^6.10.0"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.6"
  }
}
