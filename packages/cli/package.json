{
  "name": "@pippa/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "recoverysky": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pippa/types": "workspace:*",
    "commander": "^12.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.1",
    "inquirer": "^12.2.0",
    "conf": "^13.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
