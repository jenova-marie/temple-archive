# Pippa Environment Variables (Local Dev)

# API Configuration
# See vite.config.ts for proxy configuration
VITE_API_BASE_URL=https://pippa.inanna.cmd.rso

# Chat API endpoints (proxied through Vite)
# Anonymous (no auth required) - used when user is not logged in
VITE_ANON_CHAT_API_URL=http://pippa.inanna.cmd.rso:61664/api/v1/chat
# Authenticated - used when user is logged in (includes user context)
VITE_AUTH_CHAT_API_URL=https://pippa.inanna.cmd.rso/api/v1/chat

# Transcription API (for VAD voice input - @pippa/web-api)
VITE_TRANSCRIPTION_API_URL=https://pippa.inanna.cmd.rso

# Zitadel Authentication (disabled for local dev)
VITE_DISABLE_AUTH=true
VITE_ZITADEL_AUTHORITY=https://auth.rso
VITE_ZITADEL_PROJECT_ID=352079615960809474
VITE_ZITADEL_CLIENT_ID=352079658088464386

# use for local dev testing with vite
# VITE_ZITADEL_REDIRECT_URI=https://pippa.inanna.cmd.rso:5173/callback
# live production redirect
VITE_ZITADEL_REDIRECT_URI=https://pippa.inanna.cmd.rso/callback

# Feature Flags (optional)
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_TYPEWRITER=false
VITE_ENABLE_VAD_VOICE=true        # Use VAD auto-detection instead of hold-to-talk
