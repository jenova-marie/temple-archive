# Siri Environment Variables (Local Dev)

# API Configuration
# See vite.config.ts for proxy configuration
VITE_API_BASE_URL=https://archive.recoverysky.org

# Chat API endpoints (proxied through Vite)
# Anonymous (no auth required) - used when user is not logged in
VITE_ANON_CHAT_API_URL=https://archive.recoverysky.org/api/v1/chat
# Authenticated - used when user is logged in (includes user context)
VITE_AUTH_CHAT_API_URL=https://archive.recoverysky.org/api/v1/chat

# Transcription API (for VAD voice input - @siri/web-api)
VITE_TRANSCRIPTION_API_URL=https://archive.recoverysky.org

# Auth0 Authentication
VITE_AUTH0_DOMAIN=siri-ninkurgarra.us.auth0.com
VITE_AUTH0_CLIENT_ID=B2vvCaOQHbTPFyv14fOhP9y9u3zCL5SS
VITE_AUTH0_AUDIENCE=https://api.entu-siri.intra.recoverysky.net

# Feature Flags (optional)
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_TYPEWRITER=true
VITE_ENABLE_VAD_VOICE=true        # Use VAD auto-detection instead of hold-to-talk
