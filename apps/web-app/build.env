# Siri Environment Variables

# API Configuration
# These are intentionally blank/relative so the SPA always uses same-origin
# requests:
#   - Local dev:  /api/* -> vite.config.ts proxy -> http://localhost:61664
#   - Production: /api/* -> reverse proxy on archive.templeofinannaslight.org
#                            -> agent-api
# Setting them to absolute URLs causes CORS errors in local dev because the
# browser then sees a cross-origin call from localhost:61666 to prod.
VITE_API_BASE_URL=

# Chat API endpoints — leave blank to fall back to ${VITE_API_BASE_URL}/api/v1/chat
VITE_ANON_CHAT_API_URL=
VITE_AUTH_CHAT_API_URL=

# Auth0 Authentication
VITE_AUTH0_DOMAIN=templeofinannaslight.us.auth0.com
VITE_AUTH0_CLIENT_ID=86SFht25BYX6Jx9HYoyG1hsH094OQUD3
VITE_AUTH0_AUDIENCE=https://api.entu-siri.intra.recoverysky.net

# Feature Flags (optional)
VITE_ENABLE_TYPEWRITER=false
