# RecoverySky App Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:4000

# Chat API endpoint (authenticated users only)
VITE_AUTH_CHAT_API_URL=http://localhost:3333/api/v1/chat

# Transcription API (for VAD voice input - @siri/api)
VITE_TRANSCRIPTION_API_URL=http://localhost:61665

# Auth0 Authentication (REQUIRED)
VITE_AUTH0_DOMAIN=<your-tenant>.us.auth0.com
VITE_AUTH0_CLIENT_ID=<your-spa-client-id>
# API identifier configured in Auth0 dashboard (must match AUTH0_AUDIENCE on the backend)
VITE_AUTH0_AUDIENCE=https://api.siri.app

# Set to true to bypass Auth0 entirely and use a mock dev user
# VITE_DISABLE_AUTH=false

# Feature Flags (optional)
# VITE_ENABLE_VOICE_INPUT=true      # Enable voice input (hold-to-talk or VAD)
# VITE_ENABLE_TYPEWRITER=true       # Enable typing animation for AI responses
# VITE_ENABLE_VAD_VOICE=true        # Use VAD auto-detection instead of hold-to-talk
