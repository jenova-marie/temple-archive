# Pippa Agent Configuration
# ===========================
# This YAML file is the base configuration for Pippa Agent.
# Environment variables override all values set here.
#
# Variable interpolation:
#   ${VAR}           - Substitute with env var value (empty string if not set)
#   ${VAR:-default}  - Substitute with env var value, or use default if not set
#
# Example: apiKey: ${ANTHROPIC_API_KEY} will use the ANTHROPIC_API_KEY env var

# =============================================================================
# Application Settings
# =============================================================================
app:
  nodeEnv: development
  port: 3333
  logLevel: debug
  useStubs: false  # Set to true for local dev without infrastructure

# =============================================================================
# AI Provider Credentials
# =============================================================================
# These should always use env var interpolation for security
ai:
  anthropic:
    apiKey: ${ANTHROPIC_API_KEY}
  openai:
    apiKey: ${OPENAI_API_KEY}

# =============================================================================
# L1: Redis (Session Cache)
# =============================================================================
redis:
  url: ${REDIS_URL:-redis://localhost:6379}
  # password: ${REDIS_PASSWORD}
  # username: ${REDIS_USERNAME}
  db: 0
  tls: false
  userCacheTtlMinutes: 60

# =============================================================================
# L2: PostgreSQL (Conversation History)
# =============================================================================
postgresql:
  url: ${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/pippa}
  # ssl: false  # or { rejectUnauthorized: false } for self-signed certs

# =============================================================================
# L3: Neo4j (Knowledge Graph)
# =============================================================================
neo4j:
  uri: ${NEO4J_URI:-bolt://localhost:7687}
  user: neo4j
  password: ${NEO4J_PASSWORD}
  database: neo4j
  databasePerUser: false  # Set to true for multi-tenant mode

# =============================================================================
# L4: Qdrant (Vector Store)
# =============================================================================
qdrant:
  url: ${QDRANT_URL:-http://localhost:6333}
  # apiKey: ${QDRANT_API_KEY}  # For Qdrant Cloud
  collectionName: messages
  searchMode: hybrid  # 'hybrid' (dense + BM25) or 'simple' (dense only)

# =============================================================================
# Literature Search
# =============================================================================
literatureSearch:
  limit: 10

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================
observability:
  otlpEndpoint: ${OTEL_EXPORTER_OTLP_ENDPOINT:-http://localhost:4318}
  serviceName: pippa-agent

# =============================================================================
# Crisis Detection & Response
# =============================================================================
crisis:
  thresholdHigh: 7
  thresholdCritical: 9
  # webhookUrl: ${CRISIS_WEBHOOK_URL}
  # webhookSecret: ${CRISIS_WEBHOOK_SECRET}
  detectionEnabled: true
  deepEvalEnabled: true

# =============================================================================
# Response Evaluation
# =============================================================================
evaluation:
  mode: on_demand  # 'all', 'on_demand', or 'sample:N' (N% of responses)

# =============================================================================
# Authentication (Zitadel)
# =============================================================================
auth:
  zitadel:
    issuer: ${ZITADEL_ISSUER}
    audience: ${ZITADEL_AUDIENCE}

# =============================================================================
# Meeting Discovery API
# =============================================================================
meetingApi:
  url: ${MEETING_API_URL:-http://localhost:4000}
  # token: ${MEETING_API_TOKEN}

# =============================================================================
# Memory System Configuration
# =============================================================================
memory:
  # Pre-agent memory contextualization
  # 0 = off, 1 = template, 2 = haiku, 3 = hybrid
  contextMode: 1

  # Memory tool access for Claude
  # 'off', 'read', 'write', or 'full'
  toolAccess: read

  # ---------------------------------------------------------------------------
  # Entity Extraction
  # ---------------------------------------------------------------------------
  entityExtraction:
    mode: all  # 'all', 'none', 'significant', or 'sample:N'
    model: claude-3-haiku-20240307
    types:
      - person
      - place
      - event
      - emotion
      - trigger
      - coping_strategy
      - milestone
      - medication
    minImportance: 0.3
    inferRelationships: true

  # ---------------------------------------------------------------------------
  # L3 Memory Cadillac (Advanced Knowledge Graph)
  # ---------------------------------------------------------------------------
  l3:
    extractionEnabled: true
    retrievalEnabled: false  # Set to true to use new L3 retrieval
    includeObservations: true
    retrievalLimit: 10
    retrievalMaxTokens: 2000
    retrievalMinScore: 0.1

  # ---------------------------------------------------------------------------
  # Deep Memory (Conversation Context Enrichment)
  # ---------------------------------------------------------------------------
  deepMemory:
    enabled: true
    strategy: latest  # 'latest', 'created_and_latest', or 'all'
    window: 5  # Messages around each extraction point

  # ---------------------------------------------------------------------------
  # Embedding Batch Job
  # ---------------------------------------------------------------------------
  embeddingBatch:
    intervalMs: 30000
    batchSize: 100

  # ---------------------------------------------------------------------------
  # Memory Bootstrap
  # ---------------------------------------------------------------------------
  bootstrap:
    enabled: false
    start: 3  # Exchange to start bootstrapping
    end: 8    # Exchange to stop bootstrapping
    cacheLimit: 50  # or 'all' or 'none'
    cacheTtlHours: 4
    dedupThreshold: 10
    extractionModel: haiku

  # ---------------------------------------------------------------------------
  # Context Compaction
  # ---------------------------------------------------------------------------
  compaction:
    enabled: true
    threshold: 30  # Messages before compaction triggers
    batchSize: 15  # Messages to compact per batch
    model: claude-3-haiku-20240307
    maxTokens: 512
    timeoutMs: 15000

  # ---------------------------------------------------------------------------
  # Memory Reflector (Automatic Insight Extraction)
  # ---------------------------------------------------------------------------
  # Analyzes each exchange and automatically extracts:
  # - User insights (preferences, breakthroughs, goals)
  # - Entity observations (facts about mentioned entities)
  # - Reinforcements (boosts confidence on confirmed knowledge)
  reflector:
    enabled: true
    insightLimit: 10    # Max recent insights in Haiku context
    entityLimit: 5      # Max entities in Haiku context
    minConfidence: 0.5  # Minimum confidence to persist (0.0-1.0)
